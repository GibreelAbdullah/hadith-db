# Generated files — do not 3-way merge.
#
# metadata.json is produced deterministically by convert.py and regenerated +
# committed by CI (.github/workflows/generate-data.yml) on every push to
# master. Its contents therefore never need to be reconciled by hand: a merge
# conflict on it is noise. The "ours" merge driver below makes git keep the
# current branch's version on conflict; the next CI run regenerates the
# correct content from the .txt sources anyway.
#
# REQUIRED one-time local setup (per clone, not committed by git):
#   ./setup.sh          (or: git config merge.ours.driver true)
# Without that config, git falls back to the default merge for these paths.
data/books/**/metadata.json merge=ours
